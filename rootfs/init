#!/bin/sh
# Minimal init script for QEMU arm64 virt initramfs
# Mounts virtual filesystems required for LKM testing (procfs, sysfs, debugfs)

mount -t proc none /proc
mount -t sysfs none /sys
mount -t devtmpfs none /dev
mount -t debugfs none /sys/kernel/debug

# Ensure kernel log messages are visible on the serial console
echo "7 4 1 7" > /proc/sys/kernel/printk

# Set hostname for clear prompt identification
hostname p04-arm64-virt

echo ""
echo "=================================================="
echo " p04-arm64-lkm-datastructures (QEMU arm64 virt)"
echo " Kernel: $(uname -r) | Arch: $(uname -m)"
echo "=================================================="
echo ""

# Launch an interactive shell with proper job control (Ctrl+C) on ttyAMA0
exec setsid cttyhack /bin/sh
